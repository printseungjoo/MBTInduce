generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  GOOGLE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SimulationRole {
  user
  ai
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  nickname     String?
  profileImage String?
  role         UserRole         @default(USER)
  status       UserStatus       @default(ACTIVE)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  accounts     Account[]
  mbti         MbtiPreference?
  chatSessions ChatSession[]
  feedbacks    Feedback[]
  ratings      ResponseRating[]
  createdTemplates PromptTemplate[]
  simulationTemplates SimulationTemplate[]
  userProfiles UserProfile[]
  simulationChatMessages SimulationChatMessage[]

  @@index([status])
  @@index([role])
}

model Account {
  id                 String       @id @default(cuid())
  userId             String
  provider           AuthProvider
  providerAccountId  String
  accessToken        String?
  refreshToken       String?
  tokenExpiresAt     DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model MbtiPreference {
  id          String    @id @default(cuid())
  userId      String    @unique
  energy      String    @default("E")
  information String    @default("S")
  decision    String    @default("T")
  lifestyle   String    @default("J")
  /// 0–100, percent leaning toward E (matches frontend RangeBar E / I)
  energyWeight Int       @default(50)
  /// 0–100, percent leaning toward S (S / N)
  informationWeight Int  @default(50)
  /// 0–100, percent leaning toward F (F / T)
  decisionWeight Int     @default(50)
  /// 0–100, percent leaning toward P (P / J)
  lifestyleWeight Int    @default(50)
  /// Axes for “Show Both” UI: EI | SN | FT | PJ (frontend sends e.g. ["EI","SN"])
  showBothAxes String[] @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  ratings     ResponseRating[]

  @@index([userId, createdAt])
}

model Message {
  id             String      @id @default(cuid())
  chatSessionId  String
  role           MessageRole
  content        String
  promptTemplateId String?
  createdAt      DateTime    @default(now())

  chatSession    ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  ratings        ResponseRating[]

  @@index([chatSessionId, createdAt])
}

model ResponseRating {
  id            String      @id @default(cuid())
  userId        String
  chatSessionId String
  messageId     String?
  score         Int
  comment       String?
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  message       Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([chatSessionId])
}

model Feedback {
  id          String    @id @default(cuid())
  userId      String
  category    String?
  content     String
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PromptTemplate {
  id          String    @id @default(cuid())
  title       String
  content     String
  category    String?
  isActive    Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, createdAt])
}

model SimulationTemplate {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  meOrNot   Boolean  @default(false)
  mbti      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SimulationChatMessage {
  id        String         @id @default(cuid())
  userId    String
  role      SimulationRole
  content   String
  eValue    Int            @default(50)
  sValue    Int            @default(50)
  fValue    Int            @default(50)
  pValue    Int            @default(50)
  createdAt DateTime       @default(now())
  rate      Int?
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
