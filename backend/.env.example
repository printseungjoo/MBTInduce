NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mbtinduce?schema=public
SESSION_SECRET=replace_this_with_random_secret

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

CLIENT_ORIGIN=http://localhost:5173
AUTH_SUCCESS_REDIRECT=http://localhost:5173
AUTH_ADMIN_SUCCESS_REDIRECT=http://localhost:5173/admin
AUTH_FAILURE_REDIRECT=http://localhost:5173/login?error=oauth_failed

# Comma-separated emails that receive ADMIN role on signup/login (no manual DB update needed)
ADMIN_EMAILS=you@example.com,teammate@example.com

ACCOUNT_DELETE_MODE=SOFT

# OpenAI (GPT-4o mini) — put real key only in .env (never commit)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_TOKENS=1024
CHAT_MAX_MESSAGES=40

# Development-only auth bypass (set true only for local interop testing)
DEV_AUTH_BYPASS=false
DEV_AUTH_USER_ID=dev-bypass-user
DEV_AUTH_ROLE=USER
